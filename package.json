{
  "name": "@medibooker/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings=0 scripts eslint.config.js prettier.config.js vitest.config.ts",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "test": "turbo run test test:root",
    "test:root": "vitest run --coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "check:migrations": "node scripts/check-migrations.ts",
    "generate": "pnpm --filter @medibooker/api generate",
    "check:drift": "pnpm generate && node scripts/check-drift.ts",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:reset": "turbo run db:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/check-hooks.ts && node scripts/run-gitleaks.ts && prettier --check . && pnpm dedupe --check && node scripts/check-migrations.ts && turbo run lint lint:root typecheck typecheck:root test test:root build && pnpm check:drift"
  },
  "devDependencies": {
    "@medibooker/eslint-config": "workspace:*",
    "@medibooker/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
