{
  "name": "@medibooker/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint 10 flat-config presets and the local MediBooker guardrail rules.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@medibooker/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
