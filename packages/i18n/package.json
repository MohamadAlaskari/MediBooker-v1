{
  "name": "@medibooker/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Languages and texts of MediBooker v2: the ICU catalogue, locales, direction, negotiation and formats.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales.json": "./locales.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@medibooker/eslint-config": "workspace:*",
    "@medibooker/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "use-intl": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
