{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "enter": {
        "$value": [0.05, 0.7, 0.1, 1]
      },
      "exit": {
        "$value": [0.3, 0, 1, 1]
      }
    }
  }
}
