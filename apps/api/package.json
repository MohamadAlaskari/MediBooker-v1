{
  "name": "@medibooker/api",
  "version": "0.0.0",
  "private": true,
  "description": "MediBooker v2 API: NestJS 12 on Express 5, the only gateway to personal and health data.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "generate": "nest build && node dist/openapi/generate.js",
    "db:generate": "prisma generate --config prisma.platform.config.ts && prisma generate --config prisma.practice.config.ts && node scripts/write-schema-versions.ts",
    "db:migrate:dev:platform": "prisma migrate dev --create-only --config prisma.platform.config.ts",
    "db:migrate:dev:practice": "prisma migrate dev --create-only --config prisma.practice.config.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "catalog:",
    "@nestjs-cls/transactional-adapter-prisma": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "helmet": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medibooker/db-migrate": "workspace:*",
    "@medibooker/eslint-config": "workspace:*",
    "@medibooker/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@peculiar/x509": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chokidar": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
