{
  "name": "@medibooker/api",
  "version": "0.0.0",
  "private": true,
  "description": "MediBooker v2 API: NestJS 12 on Express 5, the only gateway to personal and health data.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --coverage"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/throttler": "catalog:",
    "helmet": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medibooker/eslint-config": "workspace:*",
    "@medibooker/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chokidar": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
