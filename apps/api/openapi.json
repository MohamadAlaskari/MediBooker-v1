{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ],
        "type": "string"
      },
      "FieldErrorCode": {
        "enum": [
          "REQUIRED",
          "INVALID_TYPE",
          "INVALID_FORMAT",
          "INVALID_VALUE",
          "TOO_SHORT",
          "TOO_LONG",
          "TOO_SMALL",
          "TOO_LARGE",
          "UNKNOWN_FIELD"
        ],
        "type": "string"
      },
      "FieldErrorDto": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FieldErrorCode"
              }
            ]
          },
          "field": {
            "example": "items[0].startsAt",
            "type": "string"
          },
          "message": {
            "example": "Too long",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "detail": {
            "example": "Not found",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            },
            "type": "array"
          },
          "params": {
            "additionalProperties": true,
            "type": "object"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "example": 404,
            "type": "number"
          },
          "title": {
            "example": "Not found",
            "type": "string"
          },
          "type": {
            "example": "urn:medibooker:problem:not-found",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "PublicOpeningHoursDto": {
        "properties": {
          "closesAt": {
            "description": "Local wall-clock time; 24:00 is the end of the day",
            "example": "13:00",
            "type": "string"
          },
          "opensAt": {
            "description": "Local wall-clock time",
            "example": "09:00",
            "type": "string"
          },
          "weekday": {
            "description": "ISO weekday: 1 Monday to 7 Sunday",
            "example": 1,
            "type": "number"
          }
        },
        "required": [
          "weekday",
          "opensAt",
          "closesAt"
        ],
        "type": "object"
      },
      "PublicPracticeDto": {
        "properties": {
          "about": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultLocale": {
            "example": "ar",
            "type": "string"
          },
          "directions": {
            "description": "Null when the practice hides its directions",
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "hourCycle": {
            "example": "h23",
            "type": "string"
          },
          "legalNoticeUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "description": "The locale of the texts in this response, also in Content-Language",
            "example": "ar",
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextChangeAt": {
            "description": "When openNow changes; null when it does not within 60 days or the hours are hidden",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "numberingSystem": {
            "example": "latn",
            "type": "string"
          },
          "openNow": {
            "description": "Null when the practice hides its opening hours",
            "type": [
              "boolean",
              "null"
            ]
          },
          "openingHours": {
            "items": {
              "$ref": "#/components/schemas/PublicOpeningHoursDto"
            },
            "type": "array"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "privacyPolicyUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "services": {
            "description": "Active and bookable online",
            "items": {
              "$ref": "#/components/schemas/PublicServiceDto"
            },
            "type": "array"
          },
          "slug": {
            "description": "The current slug, also when the request used a retired one",
            "example": "al-noor",
            "type": "string"
          },
          "specialDays": {
            "description": "The next 60 days",
            "items": {
              "$ref": "#/components/schemas/PublicSpecialDayDto"
            },
            "type": "array"
          },
          "supportedLocales": {
            "example": [
              "ar",
              "en"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "team": {
            "description": "Only members with an active public-profile consent that no admin has hidden",
            "items": {
              "$ref": "#/components/schemas/PublicTeamMemberDto"
            },
            "type": "array"
          },
          "theme": {
            "$ref": "#/components/schemas/PublicThemeDto"
          },
          "timeZone": {
            "description": "IANA zone: every wall-clock time here is local to it",
            "example": "Asia/Riyadh",
            "type": "string"
          },
          "today": {
            "description": "Today's date in the practice's time zone",
            "example": "2026-11-06",
            "type": "string"
          },
          "weekStart": {
            "description": "ISO weekday",
            "example": 7,
            "type": "number"
          },
          "weekendDays": {
            "description": "ISO weekdays",
            "example": [
              5,
              6
            ],
            "items": {
              "type": "number"
            },
            "type": "array"
          }
        },
        "required": [
          "slug",
          "name",
          "locale",
          "defaultLocale",
          "supportedLocales",
          "timeZone",
          "weekStart",
          "weekendDays",
          "numberingSystem",
          "hourCycle",
          "phone",
          "email",
          "address",
          "about",
          "directions",
          "legalNoticeUrl",
          "privacyPolicyUrl",
          "theme",
          "today",
          "openNow",
          "nextChangeAt",
          "openingHours",
          "specialDays",
          "services",
          "team"
        ],
        "type": "object"
      },
      "PublicServiceDto": {
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMinutes": {
            "example": 20,
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "example": "Check-up",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "type": "object"
      },
      "PublicSpecialDayDto": {
        "properties": {
          "closed": {
            "type": "boolean"
          },
          "closesAt": {
            "example": null,
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "description": "ISO date in the practice's time zone",
            "example": "2026-11-19",
            "type": "string"
          },
          "label": {
            "example": "Team training",
            "type": [
              "string",
              "null"
            ]
          },
          "opensAt": {
            "example": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "date",
          "closed",
          "opensAt",
          "closesAt",
          "label"
        ],
        "type": "object"
      },
      "PublicTeamMemberDto": {
        "properties": {
          "firstName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isProvider": {
            "type": "boolean"
          },
          "languages": {
            "example": [
              "ar",
              "en"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "lastName": {
            "type": "string"
          },
          "photoUrl": {
            "description": "Null until photos are stored, which also need their own consent",
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "specialty": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "example": "Dr.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "firstName",
          "lastName",
          "position",
          "specialty",
          "languages",
          "isProvider",
          "photoUrl"
        ],
        "type": "object"
      },
      "PublicThemeDto": {
        "properties": {
          "adjusted": {
            "type": "boolean"
          },
          "customColor": {
            "example": null,
            "type": [
              "string",
              "null"
            ]
          },
          "initials": {
            "example": "LH",
            "type": [
              "string",
              "null"
            ]
          },
          "logoUrl": {
            "description": "Null until logos are stored",
            "type": [
              "string",
              "null"
            ]
          },
          "preset": {
            "example": "TEAL",
            "type": "string"
          },
          "scale": {
            "description": "Empty, or 11 steps with a custom colour",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "preset",
          "customColor",
          "scale",
          "adjusted",
          "logoUrl",
          "initials"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "MediBooker API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/public/practices/{slug}": {
      "get": {
        "operationId": "getPublicPractice",
        "parameters": [
          {
            "description": "Chooses among the practice's locales; default: its default locale",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "example": "al-noor",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicPracticeDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "An error, as application/problem+json"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "An error, as application/problem+json"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "An error, as application/problem+json"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "An error, as application/problem+json"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "An error, as application/problem+json"
          }
        },
        "summary": "The public page of a published practice",
        "tags": [
          "public-practice"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
