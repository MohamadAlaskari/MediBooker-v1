// A practice database practice_<id32> (ADR 0005 §1.2): everything one practice owns. F04 added its
// identity, P01 its settings, page, opening hours, special days, theme, services and team. The
// schema declares no practiceId: the database is the boundary (ADR 0005 §10), and
// practice_identity is the one table that names the practice (P01's architecture test exempts
// it). Conventions: 02 §9; every field carries a class comment (health-data-security §1).

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/practice"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// How a practice's pages are coloured: a preset or a custom colour (BR-23, ADR 0002).
enum ThemePreset {
  TEAL
  OCEAN
  INDIGO
  VIOLET
  GRAPHITE
  CUSTOM

  @@map("theme_preset")
}

/// What a staff member consented to, always personally (BR-24).
enum StaffConsentType {
  PHOTO
  PUBLIC_PROFILE

  @@map("staff_consent_type")
}

/// Why a provider is away. No value says anything about health (BR-06).
enum AvailabilityExceptionReason {
  VACATION
  HOLIDAY
  TRAINING
  OTHER

  @@map("availability_exception_reason")
}

/// Whether a slot can be booked (BR-07).
enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED

  @@map("slot_status")
}

/// The practice this database belongs to: a singleton row written by provisioning. The connection
/// manager compares it with the registry before it serves a client (ADR 0005 §2.2), and the app
/// role cannot change it (ADR 0005 §4.3).
model PracticeIdentity {
  /// class: public (always 1; CHECK in the migration)
  id         Int    @id @default(1) @db.SmallInt
  /// class: public (the practice's id in the platform registry)
  practiceId String @unique @map("practice_id") @db.Uuid

  @@map("practice_identity")
}

/// The practice's country rules, contact data and booking parameters: a singleton row that the
/// migration inserts and provisioning completes. Everything market-specific lives here, not in code.
model PracticeSettings {
  /// class: public (always 1; CHECK in the migration)
  id                              Int      @id @default(1) @db.SmallInt
  /// class: public (IANA zone; set by medibooker-db provision --time-zone)
  timeZone                        String   @default("UTC") @map("time_zone")
  /// class: public (set by medibooker-db provision --default-locale; one of supportedLocales)
  defaultLocale                   String   @default("ar") @map("default_locale")
  /// class: public
  supportedLocales                String[] @default(["ar", "en"]) @map("supported_locales")
  /// class: public (ISO weekday: 1 Monday to 7 Sunday)
  weekStart                       Int      @default(1) @map("week_start") @db.SmallInt
  /// class: public (ISO weekdays; the migration writes the first value)
  weekendDays                     Int[]    @map("weekend_days") @db.SmallInt
  /// class: public (latn or arab; CHECK in the migration)
  numberingSystem                 String   @default("latn") @map("numbering_system")
  /// class: public (h12 or h23; CHECK in the migration)
  hourCycle                       String   @default("h23") @map("hour_cycle")
  /// class: public (the practice's own number)
  phone                           String?
  /// class: public (the practice's own address)
  email                           String?
  /// class: public (per locale)
  address                         Json     @default("{}")
  /// class: public (BR-02)
  maxFutureAppointmentsPerPatient Int      @default(2) @map("max_future_appointments_per_patient") @db.SmallInt
  /// class: public (BR-03)
  minLeadTimeMinutes              Int      @default(120) @map("min_lead_time_minutes")
  /// class: public (BR-03)
  maxHorizonDays                  Int      @default(90) @map("max_horizon_days") @db.SmallInt
  /// class: public (BR-04)
  cancellationDeadlineHours       Int      @default(24) @map("cancellation_deadline_hours") @db.SmallInt
  /// class: public (BR-13)
  reminderHoursBefore             Int      @default(24) @map("reminder_hours_before") @db.SmallInt
  /// class: public (BR-10: the insurance types this practice takes)
  insuranceTypes                  String[] @default(["PUBLIC", "PRIVATE", "SELF_PAY"]) @map("insurance_types")
  /// class: public (BR-10: the types that need a provider)
  insuranceProviderTypes          String[] @default(["PUBLIC", "PRIVATE"]) @map("insurance_provider_types")
  /// class: public (BR-10: the types that need a number; never SELF_PAY, CHECK in the migration)
  insuranceNumberTypes            String[] @default(["PUBLIC", "PRIVATE"]) @map("insurance_number_types")
  /// class: public
  updatedAt                       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("practice_settings")
}

/// The texts and section flags of the public practice page (BR-22): a singleton row. Publication
/// is not here but in the platform registry (practices.published_at).
model PracticePage {
  /// class: public (always 1; CHECK in the migration)
  id               Int      @id @default(1) @db.SmallInt
  /// class: public (per locale)
  about            Json     @default("{}")
  /// class: public (per locale)
  directions       Json     @default("{}")
  /// class: public
  showServices     Boolean  @default(true) @map("show_services")
  /// class: public
  showTeam         Boolean  @default(true) @map("show_team")
  /// class: public
  showOpeningHours Boolean  @default(true) @map("show_opening_hours")
  /// class: public
  showDirections   Boolean  @default(true) @map("show_directions")
  /// class: public
  legalNoticeUrl   String?  @map("legal_notice_url")
  /// class: public
  privacyPolicyUrl String?  @map("privacy_policy_url")
  /// class: public
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("practice_pages")
}

/// One interval in which the practice is open, in local wall-clock minutes (several per day are
/// possible). Independent of the providers' availability rules. No overlap: EXCLUDE in the migration.
model OpeningHours {
  /// class: public
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: public (ISO weekday: 1 Monday to 7 Sunday; CHECK in the migration)
  weekday  Int    @db.SmallInt
  /// class: public (minutes after local midnight)
  opensAt  Int    @map("opens_at") @db.SmallInt
  /// class: public (minutes after local midnight, at most 1440)
  closesAt Int    @map("closes_at") @db.SmallInt

  @@map("opening_hours")
}

/// A date with other opening hours, or closed. Replaces that weekday's hours (BR-22).
model SpecialDay {
  /// class: public
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: public (a practice-local date)
  date     DateTime @unique @db.Date
  /// class: public (closed, or valid hours; CHECK in the migration)
  closed   Boolean
  /// class: public (minutes after local midnight)
  opensAt  Int?     @map("opens_at") @db.SmallInt
  /// class: public (minutes after local midnight, at most 1440)
  closesAt Int?     @map("closes_at") @db.SmallInt
  /// class: public (per locale)
  label    Json     @default("{}")

  @@map("special_days")
}

/// The practice's colour theme (BR-23): a singleton row. The brand scale is generated by the server
/// (M01); CHECKs in the migration keep the colours safe to put into CSS. Initials are only text.
model PracticeTheme {
  /// class: public (always 1; CHECK in the migration)
  id          Int         @id @default(1) @db.SmallInt
  /// class: public
  preset      ThemePreset @default(TEAL)
  /// class: public (only with the preset CUSTOM)
  customColor String?     @map("custom_color")
  /// class: public (11 steps, only with the preset CUSTOM)
  scale       String[]    @default([])
  /// class: public (whether the contrast check changed the colour)
  adjusted    Boolean     @default(false)
  /// class: public (at most 2 characters, shown without a logo)
  initials    String?
  /// class: public
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("practice_themes")
}

/// A bookable service. Names, durations and descriptions are public on the practice page.
model Service {
  /// class: public
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: public (per locale)
  name                  Json
  /// class: public (per locale)
  description           Json     @default("{}")
  /// class: public (5 to 480; CHECK in the migration)
  durationMinutes       Int      @map("duration_minutes") @db.SmallInt
  /// class: public (BR-27: minutes its doctor stays free after it, 0 to 120; CHECK in the migration)
  bufferMinutes         Int      @default(0) @map("buffer_minutes") @db.SmallInt
  /// class: public (BR-26: patients bring a referral)
  referralRequired      Boolean  @default(false) @map("referral_required")
  /// class: public
  isBookableOnline      Boolean  @default(true) @map("is_bookable_online")
  /// class: public
  allowedInsuranceTypes String[] @default([]) @map("allowed_insurance_types")
  /// class: public
  active                Boolean  @default(true)
  /// class: public
  sortOrder             Int      @default(0) @map("sort_order")
  /// class: public
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: public
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  availabilityRules AvailabilityRuleService[]
  appointments      Appointment[]

  @@map("services")
}

/// A team member's profile. Personal data: it leaves the API only with an active PUBLIC_PROFILE
/// consent and without hiddenAt (BR-24). The link to an account arrives with the memberships (A01).
model StaffMember {
  /// class: personal
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal (for example Dr.)
  title      String?
  /// class: personal
  firstName  String    @map("first_name")
  /// class: personal
  lastName   String    @map("last_name")
  /// class: personal (per locale)
  position   Json      @default("{}")
  /// class: personal
  isProvider Boolean   @default(false) @map("is_provider")
  /// class: personal (per locale)
  specialty  Json      @default("{}")
  /// class: personal
  languages  String[]  @default([])
  /// class: personal (an admin hid the profile; no admin can consent for someone)
  hiddenAt   DateTime? @map("hidden_at") @db.Timestamptz(3)
  /// class: personal
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  consents               StaffConsent[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  slots                  Slot[]

  @@map("staff_members")
}

/// A consent a staff member gave personally, and when it was withdrawn (BR-24). A history: a new
/// row for every consent, and at most one active row per type.
model StaffConsent {
  /// class: personal
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  staffMemberId String           @map("staff_member_id") @db.Uuid
  /// class: personal
  type          StaffConsentType
  /// class: personal (the consent text the person agreed to)
  textVersion   String           @map("text_version")
  /// class: personal
  givenAt       DateTime         @map("given_at") @db.Timestamptz(3)
  /// class: personal
  withdrawnAt   DateTime?        @map("withdrawn_at") @db.Timestamptz(3)

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  @@unique([staffMemberId, type], map: "staff_consents_active_key", where: raw("(withdrawn_at IS NULL)"))
  @@map("staff_consents")
}

/// The weekly template a provider works by, in local wall-clock minutes (BR-06, BR-15). Independent
/// of the opening hours. Slots are generated from it.
model AvailabilityRule {
  /// class: personal
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal (a staff member with isProvider)
  providerId  String    @map("provider_id") @db.Uuid
  /// class: personal (ISO weekday: 1 Monday to 7 Sunday; CHECK in the migration)
  weekday     Int       @db.SmallInt
  /// class: personal (minutes after local midnight)
  startMinute Int       @map("start_minute") @db.SmallInt
  /// class: personal (minutes after local midnight, at most 1440)
  endMinute   Int       @map("end_minute") @db.SmallInt
  /// class: personal (5 to 240; CHECK in the migration)
  slotMinutes Int       @map("slot_minutes") @db.SmallInt
  /// class: personal (a practice-local date)
  validFrom   DateTime  @map("valid_from") @db.Date
  /// class: personal (a practice-local date, inclusive; null: open-ended)
  validTo     DateTime? @map("valid_to") @db.Date
  /// class: personal
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider StaffMember               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  services AvailabilityRuleService[]
  slots    Slot[]

  @@map("availability_rules")
}

/// Which services the slots of a rule can be booked for (BR-08).
model AvailabilityRuleService {
  /// class: personal
  ruleId    String @map("rule_id") @db.Uuid
  /// class: public
  serviceId String @map("service_id") @db.Uuid

  rule    AvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([ruleId, serviceId])
  @@map("availability_rule_services")
}

/// A time a provider is away: no slots are generated in it (BR-06). Not a reason for the public.
model AvailabilityException {
  /// class: personal
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  providerId String                      @map("provider_id") @db.Uuid
  /// class: personal (before endsAt; CHECK in the migration)
  startsAt   DateTime                    @map("starts_at") @db.Timestamptz(3)
  /// class: personal
  endsAt     DateTime                    @map("ends_at") @db.Timestamptz(3)
  /// class: personal
  reason     AvailabilityExceptionReason

  provider StaffMember @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@map("availability_exceptions")
}

/// A concrete time of one provider (BR-06, BR-07). Only an OPEN slot leaves the API without sign-in,
/// and only its start. No overlap per provider: EXCLUDE in the migration.
model Slot {
  /// class: personal
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  providerId String     @map("provider_id") @db.Uuid
  /// class: personal
  startsAt   DateTime   @map("starts_at") @db.Timestamptz(3)
  /// class: personal (after startsAt; CHECK in the migration)
  endsAt     DateTime   @map("ends_at") @db.Timestamptz(3)
  /// class: personal
  status     SlotStatus @default(OPEN)
  /// class: personal (null: the rule is gone, and the slot can be booked for no service)
  ruleId     String?    @map("rule_id") @db.Uuid

  provider     StaffMember       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  rule         AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([providerId, startsAt])
  @@index([ruleId])
  @@index([startsAt], map: "slots_open_starts_at_idx", where: raw("(status = 'OPEN'::slot_status)"))
  @@map("slots")
}

enum InsuranceType {
  PUBLIC
  PRIVATE
  SELF_PAY

  @@map("insurance_type")
}

/// Whom a patient profile belongs to: the account itself, or from FA01 a child of that account.
enum PatientRelationship {
  SELF
  CHILD

  @@map("patient_relationship")
}

/// A person as this practice knows them (ADR 0005 §1.3): a copy of the account's details made at the
/// join, and from then on authoritative for this practice (D16). The verified phone stays on the
/// account. At most one SELF row per user.
model Patient {
  /// class: personal
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal (null for a child without an account, FA01, and for a patient the team keeps
  /// without an account, W7)
  userId                   String?             @map("user_id") @db.Uuid
  /// class: personal
  relationship             PatientRelationship @default(SELF)
  /// class: personal
  firstName                String              @map("first_name")
  /// class: personal
  lastName                 String              @map("last_name")
  /// class: personal
  dateOfBirth              DateTime            @map("date_of_birth") @db.Date
  /// class: personal (a contact number for this practice)
  contactPhone             String?             @map("contact_phone")
  /// class: personal
  insuranceType            InsuranceType       @map("insurance_type")
  /// class: personal
  insuranceProvider        String?             @map("insurance_provider")
  /// class: secret (encrypted with this practice's data key, bound to this row)
  insuranceNumberEncrypted String?             @map("insurance_number_encrypted")
  /// class: personal (the last characters, so that a person recognises it)
  insuranceNumberEnd       String?             @map("insurance_number_end")
  /// class: secret (keyed hash with a key of this practice: the same number differs per practice)
  insuranceNumberIndex     String?             @map("insurance_number_index")
  /// class: personal (the name as the team's search compares it; written by the trigger
  /// patients_search_name of the migration, never by the API)
  searchName               String              @default("") @map("search_name")
  /// class: personal
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointments Appointment[]

  @@unique([userId], map: "patients_self_user_key", where: raw("(relationship = 'SELF'::patient_relationship)"))
  @@index([insuranceNumberIndex])
  @@map("patients")
}

/// What the platform database must learn of a change here (ADR 0005 §1.4): written in the same
/// transaction, relayed at least once. An event names no practice: the relay takes that from the
/// database it read it from, so one practice's data cannot change another's index.
model IntegrationOutbox {
  /// class: public (increases with every event: the source_version of the index)
  id          BigInt    @id @default(autoincrement())
  /// class: public
  type        String
  /// class: personal (ids and a capacity, no profile data)
  payload     Json
  /// class: public
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: public
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@index([id], map: "integration_outbox_due_idx", where: raw("(processed_at IS NULL)"))
  @@map("integration_outbox")
}

/// What happened to the personal data of this practice. Append-only for the app role (migration).
model AuditEvent {
  /// class: personal
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  at        DateTime @db.Timestamptz(3)
  /// class: personal (`user:<id>`; nothing else about a person)
  actor     String
  /// class: public (a constant such as patient.join)
  action    String
  /// class: personal (the row it happened to)
  subjectId String?  @map("subject_id") @db.Uuid
  /// class: personal (keyed hash with a key of this practice, ADR 0005 §4.8)
  ipHash    String?  @map("ip_hash")

  @@index([subjectId])
  @@map("audit_events")
}

/// What became of an appointment (BR-11). All but CANCELLED hold its slot.
enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED

  @@map("appointment_status")
}

/// A patient's booking of a slot for a service (BR-01): at most one that holds a slot. Which service a
/// person booked can reveal a condition, so all of this is health data.
model Appointment {
  /// class: health
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: health
  patientId            String            @map("patient_id") @db.Uuid
  /// class: health
  slotId               String            @map("slot_id") @db.Uuid
  /// class: health
  serviceId            String            @map("service_id") @db.Uuid
  /// class: health
  status               AppointmentStatus @default(BOOKED)
  /// class: health (encrypted with this practice's data key, bound to this row)
  patientNoteEncrypted String?           @map("patient_note_encrypted")
  /// class: personal (the account that booked: from FA01 not always the patient's own)
  bookedById           String            @map("booked_by_id") @db.Uuid
  /// class: health
  bookedAt             DateTime          @map("booked_at") @db.Timestamptz(3)
  /// class: health (set exactly when the status is CANCELLED; CHECK in the migration)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  /// class: personal (the account that cancelled)
  cancelledById        String?           @map("cancelled_by_id") @db.Uuid
  /// class: health (only a cancel by the practice has one, BR-04; sealed like the note; CHECK in the migration)
  cancelReasonEncrypted String?          @map("cancel_reason_encrypted")
  /// class: health (when the team checked the patient in, BR-11; set exactly for CHECKED_IN and COMPLETED)
  checkedInAt          DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  /// class: health (when the team completed the visit, BR-11; set exactly for COMPLETED)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// class: health (the appointment this one replaced, BR-05)
  rescheduledFromId    String?           @unique(map: "appointments_rescheduled_from_id_key") @map("rescheduled_from_id") @db.Uuid

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  slot            Slot         @relation(fields: [slotId], references: [id], onDelete: Restrict)
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo   Appointment? @relation("Reschedule")

  @@unique([slotId], map: "appointments_slot_active_key", where: raw("(status <> 'CANCELLED'::appointment_status)"))
  @@index([patientId])
  @@index([serviceId])
  @@map("appointments")
}

/// What an Idempotency-Key answered, for 24 hours: per caller, so that nobody can reach another
/// person's result with a guessed key. It holds a keyed hash of the request and never the request.
model IdempotencyKey {
  /// class: personal
  actorId       String   @map("actor_id") @db.Uuid
  /// class: public (a random value of the client)
  key           String   @db.Uuid
  /// class: secret (keyed with a key of this practice: a request can hold a note)
  requestHash   String   @map("request_hash")
  /// class: health
  appointmentId String?  @map("appointment_id") @db.Uuid
  /// class: public
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)

  @@id([actorId, key])
  @@map("idempotency_keys")
}

/// The role of a person in this practice (A04): reception, doctor or admin.
enum StaffRole {
  STAFF
  DOCTOR
  ADMIN

  @@map("staff_role")
}

/// A disabled membership answers like none, on the next request (ADR 0005 §1.4).
enum MembershipStatus {
  ACTIVE
  DISABLED

  @@map("membership_status")
}

/// Who works in this practice (A04, ADR 0005 §1.1). The platform's membership index follows this
/// table through the integration outbox; this table decides.
model Membership {
  /// class: personal
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal (the account in the platform database)
  userId    String           @unique @map("user_id") @db.Uuid
  /// class: personal
  role      StaffRole
  /// class: personal
  status    MembershipStatus @default(ACTIVE)
  /// class: personal
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("memberships")
}
