// The platform database medibooker_platform (ADR 0005 §1.1): only what has to exist outside a
// practice. F04 adds the practice registry, the database clusters and the platform audit log.
// A01 adds the accounts, their sessions and their e-mails. Conventions: 02 §9. Every field carries a class comment (health-data-security §1); hosts,
// endpoints and secret references are never logged or returned (02 §8).

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/platform"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle status of a practice; every entry point applies the status table (ADR 0005 §5.1).
enum PracticeStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  MOVING
  RESTORE_REVIEW
  DEPROVISIONING
  FINALIZED

  @@map("practice_status")
}

/// TLS of the connections to a cluster; DISABLE only in APP_ENV local and ci (ADR 0005 §4.9).
enum DatabaseClusterTlsMode {
  DISABLE
  VERIFY_FULL

  @@map("database_cluster_tls_mode")
}

enum DatabaseClusterStatus {
  ACTIVE
  DISABLED

  @@map("database_cluster_status")
}

enum PlatformAuditOutcome {
  STARTED
  SUCCEEDED
  FAILED

  @@map("platform_audit_outcome")
}

/// A PostgreSQL cluster that hosts practice databases (ADR 0005 §1.1, §7). Written only by
/// medibooker-db; platform_app may only read it (the first migration revokes its writes).
model DatabaseCluster {
  /// class: public (a lowercase slug such as local; logged as clusterId, 02 §8)
  id                   String                 @id
  /// class: public (the deployment region)
  region               String
  /// class: secret (an endpoint: never logged or returned)
  host                 String
  /// class: secret (an endpoint: never logged or returned)
  port                 Int
  /// class: public
  tlsMode              DatabaseClusterTlsMode @map("tls_mode")
  /// class: secret (a secret-store reference to the CA, not the CA; never logged or returned)
  caSecretRef          String?                @map("ca_secret_ref")
  /// class: secret (a secret-store reference, not the secret; never logged or returned)
  provisionerSecretRef String?                @map("provisioner_secret_ref")
  /// class: public (the most practice databases the cluster may hold)
  databaseLimit        Int                    @map("database_limit")
  /// class: public
  status               DatabaseClusterStatus  @default(ACTIVE)
  /// class: public
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: public
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  practices Practice[]

  @@map("database_clusters")
}

/// The practice registry (ADR 0005 §1.1): every practice, its lifecycle status and the route to
/// its own database. Status, routing, secret references, route_version and schema_version change
/// only through medibooker-db (ADR 0005 §4.4); the first migration revokes platform_app's writes.
model Practice {
  /// class: public (logged as practiceId, 02 §8)
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: public
  status             PracticeStatus @default(PROVISIONING)
  /// class: public (ISO 3166-1 alpha-2, for example SA or DE; CHECK in the migration)
  market             String         @db.Char(2)
  /// class: public
  clusterId          String?        @map("cluster_id")
  /// class: public (practice_<id32>, derived from the id; CHECK in the migration)
  databaseName       String?        @unique @map("database_name")
  /// class: secret (a secret-store reference, not the secret; never logged or returned)
  appSecretRef       String?        @map("app_secret_ref")
  /// class: secret (a secret-store reference, not the secret; never logged or returned)
  ownerSecretRef     String?        @map("owner_secret_ref")
  /// class: secret (secret-store references to this practice's data keys, never logged or returned:
  /// the first encrypts and all decrypt, so a key can be replaced row by row; ADR 0005 §4.8)
  fieldKeyRefs       String[]       @default([]) @map("field_key_refs")
  /// class: public (incremented when the route or a credential changes)
  routeVersion       Int            @default(1) @map("route_version")
  /// class: public (the newest migration applied to the practice database)
  schemaVersion      String?        @map("schema_version")
  /// class: public
  migratedAt         DateTime?      @map("migrated_at") @db.Timestamptz(3)
  /// class: public (an error code, never a message)
  migrationErrorCode String?        @map("migration_error_code")
  /// class: public (when the last physical copy expires after offboarding)
  purgedAt           DateTime?      @map("purged_at") @db.Timestamptz(3)
  /// class: public (per locale; platform_app may change it)
  name               Json           @default("{}")
  /// class: public (null: the public page answers 404; platform_app may change it)
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(3)
  /// class: public
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: public
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cluster DatabaseCluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  slugs   PracticeSlug[]
  access  PracticeAccess[]

  @@map("practices")
}

/// Current and retired slugs of every practice in one uniqueness space (ADR 0005 §1.1), so a
/// retired slug can never be taken by another practice.
model PracticeSlug {
  /// class: public (lowercase [a-z0-9-]{3,40}; CHECK in the migration)
  slug       String    @id
  /// class: public
  practiceId String    @map("practice_id") @db.Uuid
  /// class: public
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: public
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(3)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  // One current slug per practice.
  @@unique([practiceId], map: "practice_slugs_current_practice_id_key", where: raw("(retired_at IS NULL)"))
  @@map("practice_slugs")
}

/// Append-only log of the lifecycle commands and registry events (ADR 0005 §5.2), written before
/// and after each command; platform_app may only insert and read. A row names at most one
/// practice.
model PlatformAuditEvent {
  /// class: public
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: public
  occurredAt  DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// class: personal (the operator principal from the task's identity; locally local:<OS user>)
  actor       String
  /// class: public (the command or event)
  action      String
  /// class: public (no foreign key: audit rows outlive the registry rows that tests drop)
  practiceId  String?              @map("practice_id") @db.Uuid
  /// class: public
  outcome     PlatformAuditOutcome
  /// class: public (an error code, never a message)
  errorCode   String?              @map("error_code")
  /// class: public (the reviewer's approval of a gated command, ADR 0005 §5.2)
  approvalRef String?              @map("approval_ref")

  @@map("platform_audit_events")
}

/// What a single-use token of an account proves.
enum InsuranceType {
  PUBLIC
  PRIVATE
  SELF_PAY

  @@map("insurance_type")
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// The "this was not me" link of the security e-mails (A04): ends every session, asks for a new password
  SECURE_ACCOUNT

  @@map("account_token_purpose")
}

/// Which account e-mail a row of the outbox sends.
enum AccountNotificationTemplate {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// E10: a sign-in from a browser the account has not used before
  NEW_SIGN_IN
  /// A new password was chosen (BR-21)
  PASSWORD_CHANGED
  /// An authenticator app was set up for the account (BR-21, the review of A04 part 2b)
  SECOND_FACTOR_ENABLED
  /// E13: practice management changed the person's role in the team (D17), without saying which
  TEAM_ROLE_CHANGED
  /// E14: practice management ended the person's access to the team's pages (D17)
  TEAM_ACCESS_ENDED
  /// E15: practice management removed the person's authenticator app (D17, RT-96)
  TEAM_SECOND_FACTOR_RESET

  @@map("account_notification_template")
}

/// Where a queued account e-mail stands.
enum AccountNotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("account_notification_status")
}

/// One account per person on the platform (ADR 0004). What a person may do in a practice comes from
/// their membership or patient profile there, in that practice's own database (ADR 0005).
model User {
  /// class: personal
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal (case-insensitive)
  email               String    @unique @db.Citext
  /// class: secret (argon2id, never logged or returned)
  passwordHash        String    @map("password_hash")
  /// class: personal
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// class: personal (the language of e-mails to this person)
  locale              String
  /// class: personal (failed sign-ins in a row of clients the account does not know; the reason for
  /// lockedUntil; a browser it knows counts its own, KnownDevice)
  failedLoginCount    Int       @default(0) @map("failed_login_count") @db.SmallInt
  /// class: personal
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  /// class: personal (the last failed sign-in; the count decays from it, A04)
  failedLoginAt       DateTime? @map("failed_login_at") @db.Timestamptz(3)
  /// class: personal (failed sign-ins of unknown clients since the last success or new password,
  /// without decay: at 100 only a new password lets them in, A04)
  failedSinceSuccess  Int       @default(0) @map("failed_since_success") @db.SmallInt
  /// class: personal (the first sign-in: every later one from an unknown browser gets E10, A04)
  firstSignedInAt     DateTime? @map("first_signed_in_at") @db.Timestamptz(3)
  /// class: secret (the TOTP secret, encrypted with the field keys and bound to this row, A04)
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  /// class: personal (null while the second factor is not confirmed)
  totpEnabledAt       DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// class: personal (wrong codes in a row; a new password does not clear them, a right code does)
  mfaFailedCount      Int       @default(0) @map("mfa_failed_count") @db.SmallInt
  /// class: personal (until then no code counts, and the answer is that of a wrong one)
  mfaLockedUntil      DateTime? @map("mfa_locked_until") @db.Timestamptz(3)
  /// class: personal (the time step of the last code accepted: a code counts once)
  totpLastStep        BigInt?   @map("totp_last_step")
  /// class: personal
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  tokens        AccountToken[]
  consents      AccountConsent[]
  notifications AccountNotification[]
  profile       AccountProfile?
  access        PracticeAccess[]
  recoveryCodes MfaRecoveryCode[]
  devices       KnownDevice[]

  @@map("users")
}

/// The recovery codes of a second factor (ADR 0004 §7): each counts once, and a new set replaces
/// the old one.
model MfaRecoveryCode {
  /// class: personal
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId    String    @map("user_id") @db.Uuid
  /// class: secret (keyed hash of the code and its account; the code is stored nowhere)
  codeHash  String    @unique @map("code_hash")
  /// class: personal
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  /// class: personal
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// In what capacity a person may reach a practice. The practice database decides; this only says
/// where to look.
enum PracticeCapacity {
  STAFF
  PATIENT

  @@map("practice_capacity")
}

/// The membership index (ADR 0005 §1.1): which practices a person may reach, read before any
/// practice database is opened. It holds the capacity only, no profile data. It can only lag behind
/// its source in the practice, and a lagging index fails closed. Staff columns follow with A04.
model PracticeAccess {
  /// class: health (who is a patient where, ADR 0005 §1.1: never in a log line with the practice)
  userId        String           @map("user_id") @db.Uuid
  /// class: health
  practiceId    String           @map("practice_id") @db.Uuid
  /// class: health
  capacity      PracticeCapacity
  /// class: health (false until the practice has the row: a join reserves its place first)
  active        Boolean          @default(false)
  /// class: public (the id of the newest event applied; an older one is ignored)
  sourceVersion BigInt           @default(0) @map("source_version")
  /// class: health
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: health
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@id([userId, practiceId, capacity])
  @@index([practiceId])
  @@map("practice_access")
}

/// What a person enters at sign-up (D16 option B, RT-90): one entry, copied into a practice when
/// the person joins it (B01). It may be entered before the address is confirmed, so what it holds
/// is unverified until then. The insurance number is encrypted, and only its end is readable.
model AccountProfile {
  /// class: personal
  userId                   String        @id @map("user_id") @db.Uuid
  /// class: personal
  firstName                String        @map("first_name")
  /// class: personal
  lastName                 String        @map("last_name")
  /// class: personal
  dateOfBirth              DateTime      @map("date_of_birth") @db.Date
  /// class: personal (a contact number; a verified phone is another thing, ADR 0005 §1.3)
  phone                    String?
  /// class: personal
  insuranceType            InsuranceType @map("insurance_type")
  /// class: personal
  insuranceProvider        String?       @map("insurance_provider")
  /// class: secret (encrypted with FieldCipher, bound to this person)
  insuranceNumberEncrypted String?       @map("insurance_number_encrypted")
  /// class: personal (the last characters, so that a person recognises it)
  insuranceNumberEnd       String?       @map("insurance_number_end")
  /// class: personal
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_profiles")
}

/// One refresh token. Rotating it adds a row to its family, and reusing an old one revokes the whole
/// family (ADR 0004). The id is the `sid` of the access tokens issued with it.
model Session {
  /// class: personal
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId          String    @map("user_id") @db.Uuid
  /// class: personal (one sign-in and everything rotated from it)
  familyId        String    @map("family_id") @db.Uuid
  /// class: secret (SHA-256 of the refresh token, which is stored nowhere)
  tokenHash       String    @unique @map("token_hash")
  /// class: personal (how the person signed in)
  amr             String[]
  /// class: personal
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  /// class: personal (this token was replaced by a newer one of its family)
  rotatedAt       DateTime? @map("rotated_at") @db.Timestamptz(3)
  /// class: personal
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// class: personal (the sign-in of the family: it ends at an absolute time from it, A04; null in
  /// rows from before, which count from their own creation)
  familyStartedAt DateTime? @map("family_started_at") @db.Timestamptz(3)
  /// class: personal (browser or app and system, for example "Chrome · Windows"; no version, no
  /// address; at most 60 characters by a CHECK)
  device          String?

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications AccountNotification[]

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// A browser an account signed in with (A04, E10): a keyed hash of its device cookie. A sign-in from
/// another one gets the "new sign-in" e-mail; securing the account forgets them all. Each counts its
/// own failed sign-ins, so a stranger's guesses never make the owner's browser wait (OWASP device
/// cookies, the review of A04 part 2b).
model KnownDevice {
  /// class: personal
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId      String    @map("user_id") @db.Uuid
  /// class: secret (HMAC with the auth secret of the account and its device cookie, which is stored
  /// nowhere)
  deviceHash  String    @map("device_hash")
  /// class: personal
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  /// class: personal
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// class: personal (failed sign-ins in a row from this browser; the reason for lockedUntil)
  failedCount Int       @default(0) @map("failed_count") @db.SmallInt
  /// class: personal (the last failed sign-in from this browser; the count decays from it)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  /// class: personal (until then a sign-in from this browser does not count)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("known_devices")
}

/// A single-use token of an account, valid for 30 minutes (ADR 0004). The token itself is derived
/// from the id with a secret, so neither a row nor the outbox holds anything that could be used.
model AccountToken {
  /// class: personal
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId    String              @map("user_id") @db.Uuid
  /// class: personal
  purpose   AccountTokenPurpose
  /// class: secret (SHA-256 of the token)
  tokenHash String              @unique @map("token_hash")
  /// class: personal
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  /// class: personal
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  /// class: personal
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications AccountNotification[]

  @@index([userId])
  @@map("account_tokens")
}

/// What a person agreed to on the platform, and in which version of its text. A history.
model AccountConsent {
  /// class: personal
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId      String   @map("user_id") @db.Uuid
  /// class: personal (for example PRIVACY_NOTICE)
  type        String
  /// class: personal
  textVersion String   @map("text_version")
  /// class: personal
  givenAt     DateTime @map("given_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account_consents")
}

/// An account or security e-mail to send: queued in the transaction of its reason, and rendered only
/// when it is sent, from what the account says then. It holds no text, no address and no token.
model AccountNotification {
  /// class: personal
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: personal
  userId         String                      @map("user_id") @db.Uuid
  /// class: public
  template       AccountNotificationTemplate
  /// class: personal (one e-mail per reason)
  dedupeKey      String                      @unique @map("dedupe_key")
  /// class: personal
  accountTokenId String?                     @map("account_token_id") @db.Uuid
  /// class: public
  status         AccountNotificationStatus   @default(PENDING)
  /// class: public
  attempts       Int                         @default(0) @db.SmallInt
  /// class: public (also the lease of a run that is sending it)
  nextAttemptAt  DateTime                    @map("next_attempt_at") @db.Timestamptz(3)
  /// class: public
  sentAt         DateTime?                   @map("sent_at") @db.Timestamptz(3)
  /// class: public
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: personal (E10: the sign-in it tells of, for its device and time)
  sessionId      String?                     @map("session_id") @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountToken AccountToken? @relation(fields: [accountTokenId], references: [id], onDelete: Cascade)
  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountTokenId])
  @@index([sessionId])
  @@index([nextAttemptAt], map: "account_notifications_due_idx", where: raw("(status = 'PENDING'::account_notification_status)"))
  @@map("account_notifications")
}
