# The web server's environment (03 §2), checked at start by src/instrumentation.ts. Copy this file
# to apps/web/.env.local for `pnpm dev`. There are no NEXT_PUBLIC_* variables: one build serves
# every environment.

# Where the Next server reaches the API.
API_INTERNAL_URL=http://127.0.0.1:3001

# The public address of the site, for canonical links and the sitemap.
PUBLIC_SITE_URL=http://localhost:3000

# local, ci, staging or production.
APP_ENV=local
