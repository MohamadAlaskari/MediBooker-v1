{
  "extends": "@medibooker/tsconfig/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src",
    "e2e",
    "next.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
