# Local Claude Code data (plugin databases, personal settings) — never commit
.claude/data/
.claude/settings.local.json

# Dependencies, caches and build output
node_modules/
.turbo/
dist/
.next/
next-env.d.ts
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.eslintcache

# The Prisma clients and schema versions of the API, written by pnpm db:generate (02 §2)
/apps/api/src/generated/

# Test reports: the JUnit files of every Vitest run (CI uploads them), and Vitest's own folder for
# a report without an output file. Anchored to the package roots where Vitest writes them, so a
# source folder named reports (for example apps/api/src/modules/reports) is never ignored.
/reports/
/apps/*/reports/
/packages/*/reports/
/.vitest/
/apps/*/.vitest/
/packages/*/.vitest/

# Environment files: only .env.example (placeholders) is committed
.env
.env.*
*.env
!.env.example

# Local lefthook overrides: they can turn off a hook, so they stay on the developer's machine
lefthook-local.*
.lefthook-local.*

# Logs, OS and editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Keys, certificates and signing material (gitleaks cannot scan binary key stores)
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
