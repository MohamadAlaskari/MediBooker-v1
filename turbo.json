{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version", "pnpm-workspace.yaml"],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "PLATFORM_DATABASE_URL",
        "PLATFORM_MIGRATION_URL",
        "PRACTICE_MIGRATION_URL",
        "SHADOW_DATABASE_URL",
        "PROVISIONER_DATABASE_URL",
        "DATABASE_ADMIN_URL",
        "DATABASE_CLUSTER_ENDPOINTS",
        "SECRET_STORE",
        "DEV_SECRET_SEED",
        "APP_ENV",
        "MARKETS",
        "MIGRATION_*",
        "PRACTICE_APP_CONNECTION_LIMIT",
        "PRACTICE_OWNER_CONNECTION_LIMIT"
      ]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "PLATFORM_DATABASE_URL",
        "PLATFORM_MIGRATION_URL",
        "PRACTICE_MIGRATION_URL",
        "SHADOW_DATABASE_URL",
        "PROVISIONER_DATABASE_URL",
        "DATABASE_ADMIN_URL",
        "DATABASE_CLUSTER_ENDPOINTS",
        "SECRET_STORE",
        "DEV_SECRET_SEED",
        "APP_ENV",
        "MARKETS",
        "MIGRATION_*",
        "PRACTICE_APP_CONNECTION_LIMIT",
        "PRACTICE_OWNER_CONNECTION_LIMIT"
      ]
    },
    "db:reset": {
      "cache": false,
      "passThroughEnv": [
        "PLATFORM_DATABASE_URL",
        "PLATFORM_MIGRATION_URL",
        "PRACTICE_MIGRATION_URL",
        "SHADOW_DATABASE_URL",
        "PROVISIONER_DATABASE_URL",
        "DATABASE_ADMIN_URL",
        "DATABASE_CLUSTER_ENDPOINTS",
        "SECRET_STORE",
        "DEV_SECRET_SEED",
        "APP_ENV",
        "MARKETS",
        "MIGRATION_*",
        "PRACTICE_APP_CONNECTION_LIMIT",
        "PRACTICE_OWNER_CONNECTION_LIMIT"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**",
        "eslint.config.js",
        "prettier.config.js",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "packages/eslint-config/src/**",
        "packages/eslint-config/package.json",
        "packages/tsconfig/*.json"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "packages/tsconfig/*.json"
      ]
    },
    "//#test:root": {
      "env": ["GITLEAKS_VERSION"],
      "inputs": [
        "scripts/**",
        "vitest.config.ts",
        "package.json",
        "pnpm-lock.yaml",
        ".gitleaks.toml",
        ".gitleaksignore",
        "lefthook.yml",
        ".github/**",
        "renovate.json",
        "compose.dev.yaml",
        "compose.prod.yaml",
        "medibooker.cmd",
        "medibooker.sh",
        "docs/dev/getting-started.md",
        "apps/api/test/integration/support/postgres-image.ts",
        "apps/api/prisma/platform/migrations/**",
        "apps/api/prisma/practice/migrations/**"
      ],
      "outputs": ["coverage/**", "reports/**"]
    }
  }
}
