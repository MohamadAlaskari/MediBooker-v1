{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version", "pnpm-workspace.yaml"],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**",
        "eslint.config.js",
        "prettier.config.js",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "packages/eslint-config/src/**",
        "packages/eslint-config/package.json",
        "packages/tsconfig/*.json"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "packages/tsconfig/*.json"
      ]
    },
    "//#test:root": {
      "env": ["GITLEAKS_VERSION"],
      "inputs": [
        "scripts/**",
        "vitest.config.ts",
        "package.json",
        "pnpm-lock.yaml",
        ".gitleaks.toml",
        "lefthook.yml"
      ]
    }
  }
}
