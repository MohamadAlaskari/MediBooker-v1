# MediBooker v2: the one local environment file of the workspace.
# Copy it to .env in the repository root (.env is gitignored) and adjust. Never commit .env.
# Placeholders and defaults only: no real secret, no real personal data.
# Outside production the API loads this root .env itself (apps/api/src/config/load-env.ts).
# pnpm dev runs the API through Turborepo, which passes only CI and NODE_ENV from the shell, so
# with pnpm dev every value comes from here. A shell value wins only when the API is started
# directly (pnpm --filter @medibooker/api dev or start). Rules: docs/architecture/02-api.md §7.

# --- API (F03) ---

# Where links in e-mails lead (A02). Required in staging and production.
PUBLIC_WEB_URL=http://localhost:3000

# Mail server for account e-mails. Unset, the Docker stacks use their Mailpit, and pnpm dev lets
# e-mails wait and retry; for Mailpit there use the line below, which a stack cannot use. The menu
# entry "Mailserver eintragen" writes a real server here, with address and password URL-encoded.
# Everything but a local catcher needs smtps:// or requireTLS=true, in every environment. A real
# server entered here sends real e-mails from the dev stack and from pnpm dev alike.
# SMTP_URL=smtp://localhost:1025
# Who a real mail server may reach, comma-separated: required with one in local and ci, refused in
# production. Only the team's own addresses until the processor contract exists (RT-91).
# MAIL_ALLOWED_RECIPIENTS=box@example.test
MAIL_FROM="MediBooker <no-reply@medibooker.invalid>"

# How often the outbox looks for due e-mails, in seconds; 0 turns the timer off.
OUTBOX_POLL_SECONDS=5
# How often the relay visits every practice for the membership index, in seconds; 0 turns it off.
RELAY_POLL_SECONDS=900

# References into the secret store (A01). The first signing key signs and all of them verify, so a
# key can be replaced without signing anyone out. Staging and production refuse dev: references.
AUTH_SIGNING_KEY_REFS=dev:auth-signing-key
AUTH_SECRET_REF=dev:auth-secret
# The keys of encrypted fields in the platform database: the first encrypts and all decrypt.
FIELD_ENCRYPTION_KEY_REFS=dev:field-encryption-key
# The deployment key from which the keyed hashes of each practice are derived.
BLIND_INDEX_KEY_REF=dev:blind-index-key

# development (default), test or production. APP_ENV staging and production require production.
NODE_ENV=development

# local, ci, staging or production. Required, no default.
APP_ENV=local

# Port 1-65535 (default 3001).
PORT=3001

# Address to listen on. Containers use 0.0.0.0 (the default); 127.0.0.1 keeps a development API
# off the local network.
HOST=127.0.0.1

# fatal, error, warn, info (default), debug, trace or silent. fatal and silent drop the error lines
# and are rejected in staging and production.
LOG_LEVEL=info

# true or false (default). Human-readable logs through pino-pretty, a devDependency: rejected with
# NODE_ENV=production, so never in staging, production or a run of the built image.
LOG_PRETTY=false

# Comma-separated origins (scheme://host[:port], no path, no *); empty = CORS off. https only in
# production. The web app is same-origin behind the proxy and needs no entry.
CORS_ORIGINS=

# Number of trusted reverse-proxy hops in front of the API: 0 locally, 1 in the compose app
# profile; required in staging and production.
TRUST_PROXY_HOPS=0

# true or false (default). The Swagger UI at /api/docs, to try the endpoints in the browser: on for
# local development here; rejected in production.
OPENAPI_UI_ENABLED=true

# Requests per minute for the default throttler, counted per route and address (default 120); at
# most 1000 in staging and production.
RATE_LIMIT_PER_MINUTE=120

# --- Databases (F04) ---
# The compose database (pnpm db:up) on 127.0.0.1:5432. The changeme-... values are placeholders;
# the cluster keeps the passwords of its first start until docker compose down -v removes its
# volume. Rules: docs/architecture/02-api.md §5-§7.

# The platform database as platform_app, the API's role. Outside local and ci it must carry
# sslmode=verify-full and sslrootcert.
PLATFORM_DATABASE_URL=postgresql://platform_app:changeme-platform-app@127.0.0.1:5432/medibooker_platform

# Connections in the API's platform pool (default 10).
PLATFORM_DATABASE_POOL_MAX=10

# Connections in each practice client's pool (default 3).
PRACTICE_POOL_MAX=3

# Practice clients one API process keeps open at most (default 40).
PRACTICE_CLIENTS_MAX=40

# Milliseconds after which an idle practice client is closed (default 60000).
PRACTICE_CLIENT_IDLE_MS=60000

# Of PRACTICE_CLIENTS_MAX, the clients that public (slug) requests may hold at most (default 10).
PUBLIC_PRACTICE_CLIENTS_MAX=10

# Of PRACTICE_CLIENTS_MAX, the clients that jobs may hold at most (default 4).
JOB_PRACTICE_CLIENTS_MAX=4

# Practice clients one process creates per second at most (default 5).
PRACTICE_CLIENT_CREATIONS_PER_SECOND=5

# Milliseconds a practice's database credentials stay cached (default 600000).
PRACTICE_SECRET_TTL_MS=600000

# JSON map from cluster id to host:port; empty = the endpoints registered in the platform database.
# Accepted only with APP_ENV local or ci. For tools on the host: the Docker stacks may have
# registered the cluster under its container address db:5432, and they set their own value.
DATABASE_CLUSTER_ENDPOINTS={"local":"127.0.0.1:5432"}

# Milliseconds a transaction waits for a connection (default 2000).
DATABASE_TX_MAX_WAIT_MS=2000

# Milliseconds a transaction may run (default 5000).
DATABASE_TX_TIMEOUT_MS=5000

# Milliseconds a booking waits for a row lock (default 2000).
DATABASE_LOCK_TIMEOUT_MS=2000

# Where database credentials come from. dev (derived from DEV_SECRET_SEED) is accepted only with
# APP_ENV local or ci; the provider of the chosen hosting arrives in OPS01.
SECRET_STORE=dev

# The seed of the development secret store: every practice password derives from it. Local and ci
# only; required with SECRET_STORE=dev.
DEV_SECRET_SEED=changeme-dev-secret-seed

# Comma-separated ISO 3166-1 alpha-2 codes of the markets this deployment serves; empty locally,
# required in staging and production.
MARKETS=

# The keys below are read only by docker compose, medibooker-db and the Prisma CLI, never by the
# API, and only in APP_ENV local and ci.

# Password of the cluster superuser postgres (compose); repeated in DATABASE_ADMIN_URL,
# PRACTICE_MIGRATION_URL and SHADOW_DATABASE_URL.
POSTGRES_PASSWORD=changeme-postgres

# Password of platform_owner, which runs platform migrations and registry writes (compose);
# repeated in PLATFORM_MIGRATION_URL.
PLATFORM_OWNER_PASSWORD=changeme-platform-owner

# Password of platform_app, the API's role (compose); repeated in PLATFORM_DATABASE_URL.
PLATFORM_APP_PASSWORD=changeme-platform-app

# Password of medibooker_provisioner, which creates practice databases and roles (compose);
# repeated in PROVISIONER_DATABASE_URL.
PROVISIONER_PASSWORD=changeme-provisioner

# The platform database as platform_owner: medibooker-db migrate platform and the lifecycle audit.
PLATFORM_MIGRATION_URL=postgresql://platform_owner:changeme-platform-owner@127.0.0.1:5432/medibooker_platform

# The cluster as medibooker_provisioner (database postgres): provision and the local cluster
# registration. Elsewhere a secret reference in database_clusters.
PROVISIONER_DATABASE_URL=postgresql://medibooker_provisioner:changeme-provisioner@127.0.0.1:5432/postgres

# The cluster superuser (database postgres), local and ci only: pnpm db:reset, the template copies
# and the seed's practice_template.
DATABASE_ADMIN_URL=postgresql://postgres:changeme-postgres@127.0.0.1:5432/postgres

# The practice authoring database for pnpm --filter @medibooker/api db:migrate:dev:practice (the
# superuser). The migration runner sets its own value per practice.
PRACTICE_MIGRATION_URL=postgresql://postgres:changeme-postgres@127.0.0.1:5432/practice_authoring

# The shadow database of prisma migrate dev, for both schemas (the superuser).
SHADOW_DATABASE_URL=postgresql://postgres:changeme-postgres@127.0.0.1:5432/practice_shadow

# Practices the migration runner migrates at the same time (default 4).
MIGRATION_CONCURRENCY=4

# Milliseconds after which the runner stops one practice's migration (default 300000).
MIGRATION_TIMEOUT_MS=300000

# Retries of a migration that failed with lock_not_available (default 3).
MIGRATION_LOCK_RETRIES=3

# CONNECTION LIMIT of each practice's app role (default 20).
PRACTICE_APP_CONNECTION_LIMIT=20

# CONNECTION LIMIT of each practice's owner role (default 4).
PRACTICE_OWNER_CONNECTION_LIMIT=4
